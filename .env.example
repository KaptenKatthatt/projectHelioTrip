# Optional override: public origin without a trailing slash. Vercel sets
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL at build time so og:image is usually
# absolute without this. Set explicitly if you build off-platform or need a
# fixed canonical host.
VITE_PUBLIC_SITE_URL=

# Optional Facebook app id to silence "Missing Properties: fb:app_id"
# in Meta Sharing Debugger.
VITE_FACEBOOK_APP_ID=

# Optional persistent analytics backend (recommended on Vercel).
# If both are set, API analytics uses Supabase instead of ephemeral file storage.
SUPABASE_URL=
# Server-side secret key from Supabase (keep private in Vercel env).
SUPABASE_SECRET_KEY=
# Optional table name override (default: analytics_events_daily)
ANALYTICS_SUPABASE_TABLE=analytics_events_daily
# Optional RPC name for atomic increments (default: increment_analytics_event)
ANALYTICS_SUPABASE_INCREMENT_RPC=increment_analytics_event
# Optional summary query row limit (default: 5000)
ANALYTICS_QUERY_LIMIT=5000
# Optional dashboard/API read token. Strongly recommended in production.
# Send it via Authorization header (Bearer token) or secure HTTP-only cookie;
# do not send it in URL query params.
# Generate a high-entropy secret (for example: `openssl rand -hex 32` or
# a 32+ byte base64 token), keep it private, and rotate it regularly.
ANALYTICS_ADMIN_TOKEN=
