{
  "version": 3,
  "routes": [
    {
      "src": "^/textures(?:/(.*))$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^(?:/(.*\\.(?:jpg|jpeg|png|webp|gif|svg)))$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/assets(?:/(.*))$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/admin/analytics$",
      "dest": "/index.html",
      "check": true
    },
    {
      "src": "^/admin/analytics/$",
      "dest": "/index.html",
      "check": true
    },
    {
      "src": "^/api/([^/]+)$",
      "dest": "/api/[[...route]]?[...route]=$1",
      "check": true
    },
    {
      "src": "^/api(/.*)?$",
      "status": 404
    },
    {
      "handle": "error"
    },
    {
      "status": 404,
      "src": "^(?!/api).*$",
      "dest": "/404.html"
    },
    {
      "handle": "miss"
    },
    {
      "src": "^/api/(.+)(?:\\.(?:ts))$",
      "dest": "/api/$1",
      "check": true
    }
  ],
  "framework": {
    "version": "8.0.9"
  },
  "crons": []
}
